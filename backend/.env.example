NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

DATABASE_URL="postgresql://farmacia_user:farmacia_pass@localhost:5432/farmacia_db?schema=public"

# Gerar com: openssl rand -hex 32
JWT_ACCESS_SECRET=substituir-por-segredo-aleatorio-com-pelo-menos-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=substituir-por-outro-segredo-aleatorio-com-pelo-menos-32-chars
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12

LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15

CORS_ORIGINS=http://localhost:5173
